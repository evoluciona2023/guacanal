---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ContactForm from './ContactForm.astro';
import OrgIcon from './OrgIcon.astro';
import HistoryTimeline from './HistoryTimeline.astro';
import { url } from '../lib/base';

interface Props {
	entry: CollectionEntry<'organizaciones'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const otras = (await getCollection('organizaciones'))
	.filter((org) => org.slug !== entry.slug && org.data.visible)
	.sort((a, b) => a.data.order - b.data.order);

const accentText: Record<string, string> = { green: 'text-green', navy: 'text-navy', purple: 'text-purple' };
const accentBorder: Record<string, string> = { green: 'border-green', navy: 'border-navy', purple: 'border-purple' };
const accentProseHeadings: Record<string, string> = {
	green: 'prose-headings:text-green',
	navy: 'prose-headings:text-navy',
	purple: 'prose-headings:text-purple',
};
---

<section>
	{entry.data.banner && (
		<img
			src={url(entry.data.banner)}
			alt={`${entry.data.title} — ${entry.data.tagline}`}
			class="w-full h-auto sm:h-36 md:h-44 sm:object-cover sm:object-left"
		/>
	)}
</section>

<section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
	<div class:list={['mb-12 flex items-center gap-4 border-l-2 pl-5 py-1', accentBorder[entry.data.accent]]}>
		<div>
			<p class="text-xs font-semibold tracking-[0.1em] text-ink/50 uppercase">{entry.data.leaderRole}</p>
			<p class="font-display font-semibold text-xl text-ink">{entry.data.leaderName}</p>
		</div>
	</div>

	<slot name="extra" />

	{entry.data.historia && entry.data.historia.length > 0 && (
		<div class="mb-16">
			<p class:list={['text-xs font-semibold tracking-[0.15em] uppercase', accentText[entry.data.accent]]}>Reseña histórica</p>
			<h2 class="mt-2 font-display font-bold text-2xl text-ink">Historia y logros</h2>
			<div class="mt-8">
				<HistoryTimeline historia={entry.data.historia} accent={entry.data.accent} />
			</div>
		</div>
	)}

	<article
		class:list={[
			'prose prose-headings:font-display prose-headings:font-semibold max-w-none prose-p:text-ink/80 prose-li:text-ink/80 prose-strong:text-ink',
			accentProseHeadings[entry.data.accent],
			'prose-a:text-ink prose-a:underline',
		]}
	>
		<Content />
	</article>

	{entry.data.gallery && entry.data.gallery.length > 0 && (
		<div class="mt-16">
			<p class:list={['text-xs font-semibold tracking-[0.15em] uppercase', accentText[entry.data.accent]]}>Cuaderno de campo</p>
			<h2 class="mt-2 font-display font-bold text-xl text-ink">Momentos del grupo</h2>
			<div class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
				{entry.data.gallery.map((foto) => (
					<div class="aspect-square overflow-hidden rounded-md border border-ink/10">
						<img src={url(foto.src)} alt={foto.alt} loading="lazy" class="h-full w-full object-cover" />
					</div>
				))}
			</div>
		</div>
	)}

	<div class="mt-16 pt-8 border-t border-ink/10">
		<p class="text-xs font-semibold tracking-[0.1em] text-ink/40 uppercase">Otras organizaciones</p>
		<div class="mt-4 flex flex-wrap gap-3">
			{otras.map((org) => (
				<a
					href={url(`/${org.slug}`)}
					class="inline-flex items-center gap-2 rounded-md border border-ink/15 bg-white px-4 py-2 text-sm font-medium hover:border-ink transition-colors"
				>
					<OrgIcon slug={org.slug} class="w-4 h-4" />{org.data.title}
				</a>
			))}
			<a
				href={url('/')}
				class="inline-flex items-center gap-2 rounded-md px-4 py-2 text-sm text-ink/60 hover:text-ink transition-colors"
			>
				← Volver al inicio
			</a>
		</div>
	</div>
</section>

<section id="contacto" class="bg-white border-t border-ink/10 py-16">
	<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
		<p class:list={['text-xs font-semibold tracking-[0.15em] uppercase', accentText[entry.data.accent]]}>Escríbenos</p>
		<h2 class="mt-2 font-display font-bold text-2xl text-ink">Contacto</h2>
		<p class="mt-2 text-ink/70">Tu mensaje llegará marcado para {entry.data.title}.</p>
		<div class="mt-8">
			<ContactForm defaultSubject={entry.data.title} accent={entry.data.accent} />
		</div>
	</div>
</section>
