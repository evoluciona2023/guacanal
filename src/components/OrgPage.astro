---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ContactForm from './ContactForm.astro';

interface Props {
	entry: CollectionEntry<'organizaciones'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const otras = (await getCollection('organizaciones'))
	.filter((org) => org.slug !== entry.slug)
	.sort((a, b) => a.data.order - b.data.order);

const accentClasses: Record<string, string> = {
	forest: 'bg-forest text-cream',
	earth: 'bg-earth text-cream',
	sky: 'bg-sky text-cream',
};
---

<section class:list={['py-20 sm:py-28', accentClasses[entry.data.accent]]}>
	<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
		<span class="text-5xl" aria-hidden="true">{entry.data.icon}</span>
		<h1 class="mt-4 font-serif text-3xl sm:text-4xl font-semibold">{entry.data.title}</h1>
		<p class="mt-3 text-lg opacity-90">{entry.data.tagline}</p>
	</div>
</section>

<section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
	<div class="mb-12 flex items-center gap-4 rounded-2xl border border-bark/10 bg-white p-6">
		<span class="text-3xl" aria-hidden="true">👤</span>
		<div>
			<p class="text-sm text-bark/60">{entry.data.leaderRole}</p>
			<p class="font-serif text-lg font-semibold">{entry.data.leaderName}</p>
		</div>
	</div>

	<article class="prose prose-headings:font-serif prose-headings:text-forest prose-a:text-forest max-w-none">
		<Content />
	</article>

	<div class="mt-16 pt-8 border-t border-bark/10">
		<p class="text-sm font-semibold uppercase tracking-wide text-bark/50">Otras organizaciones</p>
		<div class="mt-4 flex flex-wrap gap-3">
			{otras.map((org) => (
				<a
					href={`/${org.slug}`}
					class="inline-flex items-center gap-2 rounded-full border border-bark/15 bg-white px-4 py-2 text-sm hover:border-forest hover:text-forest transition-colors"
				>
					<span aria-hidden="true">{org.data.icon}</span>{org.data.title}
				</a>
			))}
			<a
				href="/"
				class="inline-flex items-center gap-2 rounded-full bg-cream px-4 py-2 text-sm text-bark/70 hover:text-forest transition-colors"
			>
				← Volver al inicio
			</a>
		</div>
	</div>
</section>

<section id="contacto" class="bg-white border-t border-bark/10 py-16">
	<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
		<h2 class="font-serif text-2xl font-semibold text-bark">Escríbenos</h2>
		<p class="mt-2 text-bark/70">Tu mensaje llegará marcado para {entry.data.title}.</p>
		<div class="mt-6">
			<ContactForm defaultSubject={entry.data.title} />
		</div>
	</div>
</section>
