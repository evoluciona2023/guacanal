---
interface Props {
	variant: 'toPaper' | 'toDusk';
}

const { variant } = Astro.props;
const wrapBg = variant === 'toPaper' ? 'bg-dusk' : 'bg-paper';
const waveFill = variant === 'toPaper' ? 'fill-paper' : 'fill-dusk';
---

<div class:list={['relative h-10 sm:h-16 overflow-hidden', wrapBg]} aria-hidden="true">
	<svg class="absolute bottom-0 left-0 w-full h-full" viewBox="0 0 1440 100" preserveAspectRatio="none">
		<path
			d="M0,55 C180,90 320,15 520,45 C720,75 860,20 1040,50 C1220,80 1320,25 1440,50 L1440,100 L0,100 Z"
			class={waveFill}
		></path>
	</svg>
</div>
