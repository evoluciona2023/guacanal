---
interface Props {
	tone?: 'mixed' | 'ember' | 'cane' | 'rio' | 'campo';
	class?: string;
}

const { tone = 'mixed', class: className = '' } = Astro.props;

const palettes: Record<string, string[]> = {
	mixed: ['stroke-rio', 'stroke-campo', 'stroke-cane', 'stroke-ember', 'stroke-rio', 'stroke-campo', 'stroke-cane', 'stroke-ember'],
	ember: Array(8).fill('stroke-ember'),
	cane: Array(8).fill('stroke-cane'),
	rio: Array(8).fill('stroke-rio'),
	campo: Array(8).fill('stroke-campo'),
};
const opacities = ['opacity-15', 'opacity-20', 'opacity-25', 'opacity-30', 'opacity-35', 'opacity-40', 'opacity-30', 'opacity-45'];
const colors = palettes[tone];

const lines = [
	'M-20,55 C150,35 300,70 450,48 C600,25 750,60 900,42 C1050,20 1200,55 1350,38 C1400,34 1460,42 1460,42',
	'M-20,110 C100,95 200,120 320,100 C440,80 540,115 660,95 C780,75 900,110 1020,92 C1140,74 1260,105 1380,90 C1420,86 1460,92 1460,92',
	'M-20,165 C200,140 400,185 600,155 C800,125 1000,175 1200,150 C1300,138 1400,155 1460,148',
	'M-20,220 C80,200 160,235 260,215 C360,195 460,230 560,210 C680,185 800,225 920,205 C1040,185 1160,220 1280,200 C1360,188 1420,205 1460,198',
	'M-20,275 C250,250 500,295 750,265 C900,248 1100,280 1300,258 C1380,250 1430,262 1460,258',
	'M-20,330 C120,310 240,345 360,325 C480,305 600,340 720,320 C840,300 960,335 1080,315 C1200,295 1320,325 1460,312',
	'M-20,385 C300,360 600,400 900,370 C1050,355 1250,378 1460,365',
	'M-20,430 C200,410 400,445 600,420 C800,395 1000,435 1200,410 C1350,392 1420,405 1460,400',
];
---

<svg
	class:list={['absolute inset-0 w-full h-full', className]}
	viewBox="0 0 1440 480"
	preserveAspectRatio="none"
	fill="none"
	aria-hidden="true"
>
	{lines.map((d, i) => (
		<path d={d} class:list={[colors[i], opacities[i]]} stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" />
	))}
</svg>
