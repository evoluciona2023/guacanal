---
import type { CollectionEntry } from 'astro:content';

interface Props {
	org: CollectionEntry<'organizaciones'>;
}

const { org } = Astro.props;

const accentClasses: Record<string, string> = {
	forest: 'bg-forest/10 text-forest',
	earth: 'bg-earth/10 text-earth',
	sky: 'bg-sky/10 text-sky',
};
---

<a
	href={`/${org.slug}`}
	class="group flex flex-col gap-4 rounded-2xl border border-bark/10 bg-white p-6 transition-all hover:-translate-y-1 hover:shadow-lg"
>
	<span class:list={['inline-flex h-12 w-12 items-center justify-center rounded-full text-2xl', accentClasses[org.data.accent]]} aria-hidden="true">
		{org.data.icon}
	</span>
	<div>
		<h3 class="font-serif text-lg font-semibold text-bark">{org.data.title}</h3>
		<p class="mt-1 text-sm text-bark/70">{org.data.tagline}</p>
	</div>
	<span class="mt-auto inline-flex items-center gap-1 text-sm font-medium text-forest group-hover:gap-2 transition-all">
		Conocer más
		<svg class="w-4 h-4" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
	</span>
</a>
