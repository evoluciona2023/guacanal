---
import type { CollectionEntry } from 'astro:content';
import OrgIcon from './OrgIcon.astro';

interface Props {
	org: CollectionEntry<'organizaciones'>;
	index: number;
}

const { org, index } = Astro.props;

const accentText: Record<string, string> = {
	ember: 'text-ember',
	cane: 'text-cane',
	rio: 'text-rio',
	campo: 'text-campo',
};
const accentBg: Record<string, string> = {
	ember: 'bg-ember/10',
	cane: 'bg-cane/10',
	rio: 'bg-rio/10',
	campo: 'bg-campo/10',
};
---

<a
	href={`/${org.slug}`}
	class="group grid grid-cols-[auto_auto_1fr_auto] sm:grid-cols-[3.5rem_3rem_1fr_auto] items-center gap-4 sm:gap-6 border-b border-ink/10 py-6 transition-colors hover:bg-ember/[0.04]"
>
	<span class="font-mono text-xs text-ink/40">{String(index).padStart(2, '0')}</span>

	<span class:list={['inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full', accentBg[org.data.accent]]}>
		<OrgIcon slug={org.slug} class:list={['w-5 h-5', accentText[org.data.accent]]} />
	</span>

	<span class="min-w-0">
		<span class="block font-serif text-xl sm:text-2xl text-ink">{org.data.title}</span>
		<span class="block text-sm text-ink/60 truncate">{org.data.tagline}</span>
	</span>

	<span class="hidden sm:inline-flex items-center gap-1 text-sm font-medium text-ink/50 group-hover:text-ink group-hover:gap-2 transition-all">
		Ver
		<svg class="w-4 h-4" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
	</span>
</a>
