---
const fotos = [
	{ src: '/images/galeria/2.jpeg', alt: 'Atardecer sobre las montañas de Guacanal, con cultivos en primer plano' },
	{ src: '/images/galeria/9.jpeg', alt: 'Bienparado (potoo) posado en un poste, con platanales de fondo' },
	{ src: '/images/galeria/7.jpeg', alt: 'Flor de borrachero (Brugmansia) en un jardín de la vereda' },
	{ src: '/images/galeria/6.jpeg', alt: 'Luna llena sobre el cultivo, junto a una carreta de cosecha' },
	{ src: '/images/galeria/5.jpeg', alt: 'Gavilán posado entre el follaje' },
	{ src: '/images/galeria/3.jpeg', alt: 'Pericos en la copa de un árbol' },
];
---

<div class="columns-2 sm:columns-3 gap-3 sm:gap-4 [column-fill:balance]" data-gallery>
	{fotos.map((foto, i) => (
		<button
			type="button"
			class="group mb-3 sm:mb-4 block w-full break-inside-avoid overflow-hidden rounded-md border border-ink/10 relative"
			data-index={i}
			aria-label={`Ampliar foto: ${foto.alt}`}
		>
			<img src={foto.src} alt={foto.alt} loading="lazy" class="w-full h-auto" />
			<span class="absolute inset-0 bg-ink/0 group-hover:bg-ink/10 transition-colors"></span>
			<span class="absolute bottom-2 right-2 h-8 w-8 rounded-full bg-white/90 text-ink flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
				<svg class="w-4 h-4" viewBox="0 0 20 20" fill="none"><path d="M8 3H3v5M12 3h5v5M3 12v5h5M17 12v5h-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
			</span>
		</button>
	))}
</div>

<div
	id="gallery-lightbox"
	class="fixed inset-0 z-50 hidden bg-ink/90 backdrop-blur-sm items-center justify-center p-4 sm:p-8"
	role="dialog"
	aria-modal="true"
	aria-label="Foto ampliada"
>
	<button
		type="button"
		data-lightbox-close
		class="absolute top-4 right-4 sm:top-6 sm:right-6 h-10 w-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors"
		aria-label="Cerrar"
	>
		<svg class="w-5 h-5" viewBox="0 0 20 20" fill="none"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
	</button>

	<button
		type="button"
		data-lightbox-prev
		class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 h-11 w-11 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors"
		aria-label="Foto anterior"
	>
		<svg class="w-5 h-5" viewBox="0 0 20 20" fill="none"><path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
	</button>

	<figure class="max-w-4xl w-full max-h-full flex flex-col items-center">
		<img data-lightbox-img src="" alt="" class="max-h-[75vh] w-auto rounded-md object-contain" />
		<figcaption data-lightbox-caption class="mt-4 text-center text-sm text-white/80 max-w-xl"></figcaption>
	</figure>

	<button
		type="button"
		data-lightbox-next
		class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 h-11 w-11 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors"
		aria-label="Foto siguiente"
	>
		<svg class="w-5 h-5" viewBox="0 0 20 20" fill="none"><path d="M8 4l6 6-6 6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>
	</button>
</div>

<script>
	const gallery = document.querySelector('[data-gallery]');
	const lightbox = document.getElementById('gallery-lightbox');
	if (gallery && lightbox) {
		const buttons = Array.from(gallery.querySelectorAll<HTMLButtonElement>('button[data-index]'));
		const photos = buttons.map((btn) => {
			const img = btn.querySelector('img');
			return { src: img?.getAttribute('src') ?? '', alt: img?.getAttribute('alt') ?? '' };
		});

		const imgEl = lightbox.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
		const captionEl = lightbox.querySelector<HTMLElement>('[data-lightbox-caption]')!;
		let current = 0;
		let lastFocused: HTMLElement | null = null;

		function show(index: number) {
			current = (index + photos.length) % photos.length;
			const photo = photos[current];
			imgEl.src = photo.src;
			imgEl.alt = photo.alt;
			captionEl.textContent = photo.alt;
		}

		function open(index: number) {
			lastFocused = document.activeElement as HTMLElement;
			show(index);
			lightbox!.classList.remove('hidden');
			lightbox!.classList.add('flex');
			document.body.style.overflow = 'hidden';
			(lightbox!.querySelector('[data-lightbox-close]') as HTMLElement)?.focus();
		}

		function close() {
			lightbox!.classList.add('hidden');
			lightbox!.classList.remove('flex');
			document.body.style.overflow = '';
			lastFocused?.focus();
		}

		buttons.forEach((btn, i) => btn.addEventListener('click', () => open(i)));
		lightbox.querySelector('[data-lightbox-close]')?.addEventListener('click', close);
		lightbox.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
		lightbox.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
		lightbox.addEventListener('click', (e) => {
			if (e.target === lightbox) close();
		});
		document.addEventListener('keydown', (e) => {
			if (lightbox!.classList.contains('hidden')) return;
			if (e.key === 'Escape') close();
			if (e.key === 'ArrowLeft') show(current - 1);
			if (e.key === 'ArrowRight') show(current + 1);
		});
	}
</script>
