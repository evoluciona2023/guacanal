---
import { getCollection } from 'astro:content';
import { url } from '../lib/base';

interface Props {
	defaultSubject?: string;
	accent?: 'green' | 'navy' | 'purple';
}

const { defaultSubject = 'General', accent = 'green' } = Astro.props;

const visibleOrgs = (await getCollection('organizaciones', ({ data }) => data.visible)).sort(
	(a, b) => a.data.order - b.data.order,
);
const subjects = ['General', ...visibleOrgs.map((org) => org.data.title)];
if (!subjects.includes(defaultSubject)) subjects.push(defaultSubject);

const focusRing: Record<string, string> = {
	green: 'focus:border-green focus:ring-green',
	navy: 'focus:border-navy focus:ring-navy',
	purple: 'focus:border-purple focus:ring-purple',
};
const buttonBg: Record<string, string> = {
	green: 'bg-green hover:bg-green/90',
	navy: 'bg-navy hover:bg-navy/90',
	purple: 'bg-purple hover:bg-purple/90',
};
const fieldClass = `w-full rounded-md border border-ink/20 bg-white px-4 py-2.5 text-ink focus:ring-1 outline-none ${focusRing[accent]}`;
---

<form
	name="contacto"
	method="POST"
	data-netlify="true"
	netlify-honeypot="empresa"
	action={url('/gracias')}
	class="grid gap-4 max-w-xl"
>
	<input type="hidden" name="form-name" value="contacto" />
	<p class="hidden">
		<label>No llenar si eres humano: <input name="empresa" /></label>
	</p>

	<div>
		<label for="nombre" class="block text-sm font-medium mb-1">Nombre</label>
		<input id="nombre" name="nombre" type="text" required class={fieldClass} />
	</div>

	<div>
		<label for="correo" class="block text-sm font-medium mb-1">Correo</label>
		<input id="correo" name="correo" type="email" required class={fieldClass} />
	</div>

	<div>
		<label for="asunto" class="block text-sm font-medium mb-1">Asunto</label>
		<select id="asunto" name="asunto" class={fieldClass}>
			{subjects.map((subject) => (
				<option selected={defaultSubject === subject}>{subject}</option>
			))}
		</select>
	</div>

	<div>
		<label for="mensaje" class="block text-sm font-medium mb-1">Mensaje</label>
		<textarea id="mensaje" name="mensaje" rows="4" required class={fieldClass}></textarea>
	</div>

	<button
		type="submit"
		class:list={['justify-self-start rounded-md text-white px-6 py-2.5 font-semibold transition-colors', buttonBg[accent]]}
	>
		Enviar mensaje
	</button>
</form>
