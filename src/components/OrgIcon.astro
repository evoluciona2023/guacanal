---
interface Props {
	slug: string;
	class?: string;
}

const { slug, class: className = 'w-6 h-6' } = Astro.props;
---

{slug === 'junta' && (
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className}>
		<path d="M6 21V4" />
		<path d="M6 5c2-1.5 4-1.5 6 0s4 1.5 6 0v8c-2 1.5-4 1.5-6 0s-4-1.5-6 0" />
	</svg>
)}

{slug === 'aproagua' && (
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className}>
		<path d="M12 21V5" />
		<path d="M12 8c-2.5-1-4-3-4-5" />
		<path d="M12 12c2.5-1 4-3 4-5" />
		<path d="M12 16c-2.5-1-4-3-4-5" />
	</svg>
)}

{slug === 'mi-campo-emprende' && (
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className}>
		<path d="M5 10h14l-1.5 9a2 2 0 0 1-2 1.7H8.5a2 2 0 0 1-2-1.7L5 10Z" />
		<path d="M8 10c0-3 1.8-5 4-5s4 2 4 5" />
		<path d="M9 13v4M12 13v4M15 13v4" />
	</svg>
)}

{slug === 'tercera-edad' && (
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className}>
		<circle cx="12" cy="12" r="4.5" />
		<path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.5 5.5l2 2M16.5 16.5l2 2M18.5 5.5l-2 2M7.5 16.5l-2 2" />
	</svg>
)}

{slug === 'consejo-comunitario' && (
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className}>
		<ellipse cx="12" cy="6" rx="7" ry="3" />
		<path d="M5 6v9c0 1.7 3.1 3 7 3s7-1.3 7-3V6" />
		<path d="M5 10.5c0 1.7 3.1 3 7 3s7-1.3 7-3" />
	</svg>
)}
