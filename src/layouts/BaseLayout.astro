---
import { getCollection } from 'astro:content';
import OrgIcon from '../components/OrgIcon.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Vereda Guacanal, El Cerrito - Valle del Cauca. Historia, comunidad y vida de campo.' } = Astro.props;

const organizaciones = (await getCollection('organizaciones')).sort((a, b) => a.data.order - b.data.order);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<title>{title} · Vereda Guacanal</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Karla:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-paper text-ink font-sans antialiased">
		<a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-ember focus:text-paper focus:px-4 focus:py-2">
			Saltar al contenido
		</a>

		<header class="sticky top-0 z-40 bg-paper/95 backdrop-blur border-b border-ink/10">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
				<a href="/" class="font-serif italic text-2xl text-ink">Guacanal</a>

				<nav class="hidden md:flex items-center gap-8 text-sm font-medium">
					<a href="/#inicio" class="hover:text-ember transition-colors">Inicio</a>
					<a href="/#historia" class="hover:text-ember transition-colors">Historia</a>
					<div class="relative group">
						<button class="hover:text-ember transition-colors flex items-center gap-1">
							Organizaciones
							<svg class="w-3 h-3" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</button>
						<div class="absolute left-0 top-full pt-2 hidden group-hover:block group-focus-within:block">
							<ul class="bg-paper rounded-md shadow-lg border border-ink/10 py-2 w-64">
								{organizaciones.map((org) => (
									<li>
										<a
											href={`/${org.slug}`}
											class:list={[
												'flex items-center gap-3 px-4 py-2 text-sm hover:bg-ink/5 transition-colors',
												currentPath === `/${org.slug}` && 'text-ember font-semibold',
											]}
										>
											<OrgIcon slug={org.slug} class="w-4 h-4 shrink-0" />
											{org.data.title}
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>
					<a href="/#galeria" class="hover:text-ember transition-colors">Galería</a>
					<a href="/#contacto" class="rounded-sm bg-ink text-paper px-4 py-2 hover:bg-ember transition-colors">Contacto</a>
				</nav>

				<details class="md:hidden relative">
					<summary class="list-none cursor-pointer p-2 -mr-2" aria-label="Abrir menú">
						<svg class="w-6 h-6 text-ink" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
					</summary>
					<div class="absolute right-0 top-full mt-2 w-64 bg-paper rounded-md shadow-lg border border-ink/10 py-2">
						<a href="/#inicio" class="block px-4 py-2 text-sm hover:bg-ink/5">Inicio</a>
						<a href="/#historia" class="block px-4 py-2 text-sm hover:bg-ink/5">Historia</a>
						<p class="px-4 pt-3 pb-1 text-xs font-mono uppercase tracking-wide text-ink/40">Organizaciones</p>
						{organizaciones.map((org) => (
							<a href={`/${org.slug}`} class="flex items-center gap-3 px-4 py-2 text-sm hover:bg-ink/5">
								<OrgIcon slug={org.slug} class="w-4 h-4 shrink-0" />{org.data.title}
							</a>
						))}
						<a href="/#galeria" class="block px-4 py-2 text-sm hover:bg-ink/5">Galería</a>
						<a href="/#contacto" class="block px-4 py-2 text-sm font-semibold text-ember hover:bg-ink/5">Contacto</a>
					</div>
				</details>
			</div>
		</header>

		<main id="contenido">
			<slot />
		</main>

		<footer class="bg-dusk text-paper">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid gap-10 sm:grid-cols-3">
				<div>
					<p class="font-serif italic text-2xl">Guacanal</p>
					<p class="mt-3 text-sm text-paper/60 font-mono">
						San Antonio · El Cerrito, Valle del Cauca
					</p>
				</div>
				<div>
					<p class="text-xs font-mono uppercase tracking-wide text-paper/40">Organizaciones</p>
					<ul class="mt-3 space-y-1.5 text-sm">
						{organizaciones.map((org) => (
							<li><a href={`/${org.slug}`} class="text-paper/80 hover:text-ember transition-colors">{org.data.title}</a></li>
						))}
					</ul>
				</div>
				<div>
					<p class="text-xs font-mono uppercase tracking-wide text-paper/40">Síguenos</p>
					<p class="mt-3 text-sm text-paper/60">
						*[PENDIENTE: agregar enlaces a Facebook / Instagram / WhatsApp]*
					</p>
				</div>
			</div>
			<div class="border-t border-paper/10 py-4 text-center text-xs font-mono text-paper/40">
				© {new Date().getFullYear()} Vereda Guacanal, El Cerrito - Valle
			</div>
		</footer>
	</body>
</html>
