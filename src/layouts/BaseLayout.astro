---
import { getCollection } from 'astro:content';
import OrgIcon from '../components/OrgIcon.astro';
import { url } from '../lib/base';

interface Props {
	title: string;
	description?: string;
	accent?: 'green' | 'navy' | 'purple';
}

const { title, description = 'Vereda Guacanal, El Cerrito - Valle del Cauca. Historia, comunidad y vida de campo.', accent = 'green' } = Astro.props;

const organizaciones = (await getCollection('organizaciones', ({ data }) => data.visible)).sort((a, b) => a.data.order - b.data.order);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const accentText: Record<string, string> = { green: 'text-green', navy: 'text-navy', purple: 'text-purple' };
const accentBorder: Record<string, string> = { green: 'border-green', navy: 'border-navy', purple: 'border-purple' };
const navLabels: Record<string, string> = {
	junta: 'Junta',
	aproagua: 'Aproagua',
	'mi-campo-emprende': 'Mi Campo Emprende',
	'tercera-edad': 'Tercera Edad',
	'consejo-comunitario': 'Consejo Comunitario',
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<meta name="description" content={description} />
		<title>{title} · Vereda Guacanal</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-paper text-ink font-sans antialiased">
		<a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-green focus:text-white focus:px-4 focus:py-2">
			Saltar al contenido
		</a>

		<header class="sticky top-0 z-40 bg-paper/95 backdrop-blur border-b border-ink/10">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-20 gap-6">
				<a href={url('/')} class="shrink-0">
					<p class="font-display font-extrabold text-2xl text-green leading-none">Guacanal</p>
					<p class="text-[11px] text-ink/50 tracking-wide">Juntos por nuestra vereda</p>
				</a>

				<nav class="hidden md:flex items-center gap-6 lg:gap-8 text-sm font-semibold uppercase tracking-wide">
					<a
						href={url('/#inicio')}
						class:list={['pb-1 border-b-2 hover:text-green transition-colors', currentPath === '/' ? [accentText[accent], accentBorder[accent]] : 'border-transparent']}
					>
						Inicio
					</a>
					{organizaciones.map((org) => (
						<a
							href={url(`/${org.slug}`)}
							class:list={[
								'pb-1 border-b-2 hover:text-green transition-colors whitespace-nowrap',
								currentPath === `/${org.slug}` || currentPath.startsWith(`/${org.slug}/`)
									? [accentText[org.data.accent], accentBorder[org.data.accent]]
									: 'border-transparent',
							]}
						>
							{navLabels[org.slug] ?? org.data.title}
						</a>
					))}
					<a href={url('/#contacto')} class="pb-1 border-b-2 border-transparent hover:text-green transition-colors">Contacto</a>
				</nav>

				<details class="md:hidden relative shrink-0">
					<summary class="list-none cursor-pointer p-2 -mr-2" aria-label="Abrir menú">
						<svg class="w-6 h-6 text-ink" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
					</summary>
					<div class="absolute right-0 top-full mt-2 w-64 bg-white rounded-md shadow-lg border border-ink/10 py-2">
						<a href={url('/#inicio')} class="block px-4 py-2 text-sm font-medium hover:bg-ink/5">Inicio</a>
						{organizaciones.map((org) => (
							<a href={url(`/${org.slug}`)} class="flex items-center gap-3 px-4 py-2 text-sm font-medium hover:bg-ink/5">
								<OrgIcon slug={org.slug} class="w-4 h-4 shrink-0" />{org.data.title}
							</a>
						))}
						<a href={url('/#galeria')} class="block px-4 py-2 text-sm font-medium hover:bg-ink/5">Galería</a>
						<a href={url('/#contacto')} class="block px-4 py-2 text-sm font-semibold text-green hover:bg-ink/5">Contacto</a>
					</div>
				</details>
			</div>
		</header>

		<main id="contenido">
			<slot />
		</main>

		<footer class="bg-green text-white">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid gap-10 sm:grid-cols-3">
				<div>
					<p class="font-display font-extrabold text-2xl">Guacanal</p>
					<p class="mt-3 text-sm text-white/70">
						San Antonio · El Cerrito, Valle del Cauca
					</p>
				</div>
				<div>
					<p class="text-xs font-semibold uppercase tracking-wide text-white/60">Organizaciones</p>
					<ul class="mt-3 space-y-1.5 text-sm">
						{organizaciones.map((org) => (
							<li><a href={url(`/${org.slug}`)} class="text-white/85 hover:text-white transition-colors">{org.data.title}</a></li>
						))}
					</ul>
				</div>
				<div>
					<p class="text-xs font-semibold uppercase tracking-wide text-white/60">Síguenos</p>
					<p class="mt-3 text-sm text-white/70">
						*[PENDIENTE: agregar enlaces a Facebook / Instagram / WhatsApp]*
					</p>
				</div>
			</div>
			<div class="border-t border-white/15 py-4 text-center text-xs text-white/60">
				© {new Date().getFullYear()} Vereda Guacanal, El Cerrito - Valle
			</div>
		</footer>
	</body>
</html>
