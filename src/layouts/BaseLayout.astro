---
import { getCollection } from 'astro:content';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Vereda Guacanal, El Cerrito - Valle del Cauca. Historia, comunidad y vida de campo.' } = Astro.props;

const organizaciones = (await getCollection('organizaciones')).sort((a, b) => a.data.order - b.data.order);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} />
		<title>{title} · Vereda Guacanal</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-cream text-bark font-sans antialiased">
		<a href="#contenido" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-forest focus:text-cream focus:px-4 focus:py-2">
			Saltar al contenido
		</a>

		<header class="sticky top-0 z-40 bg-cream/95 backdrop-blur border-b border-forest/10">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between h-16">
				<a href="/" class="font-serif text-xl font-semibold text-forest">Guacanal</a>

				<nav class="hidden md:flex items-center gap-8 text-sm font-medium">
					<a href="/#inicio" class="hover:text-forest transition-colors">Inicio</a>
					<a href="/#historia" class="hover:text-forest transition-colors">Historia</a>
					<div class="relative group">
						<button class="hover:text-forest transition-colors flex items-center gap-1">
							Organizaciones
							<svg class="w-3 h-3" viewBox="0 0 12 12" fill="none"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</button>
						<div class="absolute left-0 top-full pt-2 hidden group-hover:block group-focus-within:block">
							<ul class="bg-white rounded-xl shadow-lg border border-forest/10 py-2 w-64">
								{organizaciones.map((org) => (
									<li>
										<a
											href={`/${org.slug}`}
											class:list={[
												'flex items-center gap-2 px-4 py-2 text-sm hover:bg-cream transition-colors',
												currentPath === `/${org.slug}` && 'text-forest font-semibold',
											]}
										>
											<span aria-hidden="true">{org.data.icon}</span>
											{org.data.title}
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>
					<a href="/#galeria" class="hover:text-forest transition-colors">Galería</a>
					<a href="/#contacto" class="rounded-full bg-forest text-cream px-4 py-2 hover:bg-forest-light transition-colors">Contacto</a>
				</nav>

				<details class="md:hidden relative">
					<summary class="list-none cursor-pointer p-2 -mr-2" aria-label="Abrir menú">
						<svg class="w-6 h-6 text-forest" viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
					</summary>
					<div class="absolute right-0 top-full mt-2 w-64 bg-white rounded-xl shadow-lg border border-forest/10 py-2">
						<a href="/#inicio" class="block px-4 py-2 text-sm hover:bg-cream">Inicio</a>
						<a href="/#historia" class="block px-4 py-2 text-sm hover:bg-cream">Historia</a>
						<p class="px-4 pt-3 pb-1 text-xs uppercase tracking-wide text-bark/50">Organizaciones</p>
						{organizaciones.map((org) => (
							<a href={`/${org.slug}`} class="flex items-center gap-2 px-4 py-2 text-sm hover:bg-cream">
								<span aria-hidden="true">{org.data.icon}</span>{org.data.title}
							</a>
						))}
						<a href="/#galeria" class="block px-4 py-2 text-sm hover:bg-cream">Galería</a>
						<a href="/#contacto" class="block px-4 py-2 text-sm font-semibold text-forest hover:bg-cream">Contacto</a>
					</div>
				</details>
			</div>
		</header>

		<main id="contenido">
			<slot />
		</main>

		<footer class="bg-forest text-cream mt-24">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid gap-10 sm:grid-cols-3">
				<div>
					<p class="font-serif text-lg font-semibold">Vereda Guacanal</p>
					<p class="mt-2 text-sm text-cream/70">
						Corregimiento de San Antonio, municipio de El Cerrito, Valle del Cauca.
					</p>
				</div>
				<div>
					<p class="text-sm font-semibold uppercase tracking-wide text-cream/60">Organizaciones</p>
					<ul class="mt-2 space-y-1 text-sm">
						{organizaciones.map((org) => (
							<li><a href={`/${org.slug}`} class="hover:text-earth transition-colors">{org.data.title}</a></li>
						))}
					</ul>
				</div>
				<div>
					<p class="text-sm font-semibold uppercase tracking-wide text-cream/60">Síguenos</p>
					<p class="mt-2 text-sm text-cream/70">
						*[PENDIENTE: agregar enlaces a Facebook / Instagram / WhatsApp]*
					</p>
				</div>
			</div>
			<div class="border-t border-cream/10 py-4 text-center text-xs text-cream/50">
				© {new Date().getFullYear()} Vereda Guacanal, El Cerrito - Valle.
			</div>
		</footer>
	</body>
</html>
