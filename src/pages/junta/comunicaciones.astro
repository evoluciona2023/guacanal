---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const comunicados = (await getCollection('comunicados', ({ data }) => data.org === 'junta')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const rendered = await Promise.all(comunicados.map((entry) => entry.render()));

const formatDate = (date: Date) =>
	new Intl.DateTimeFormat('es-CO', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);
---

<BaseLayout title="Comunicaciones" description="Noticias y comunicados de la Junta de Acción Comunal de Guacanal." accent="navy">
	<section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
		<a href="/junta" class="inline-flex items-center gap-2 text-sm text-ink/60 hover:text-navy transition-colors">
			← Volver a la Junta
		</a>

		<p class="mt-6 text-xs font-semibold tracking-[0.15em] text-navy uppercase">Junta de Acción Comunal</p>
		<h1 class="mt-2 font-display font-bold text-3xl sm:text-4xl text-ink">Comunicaciones</h1>
		<p class="mt-3 text-ink/70">Noticias, gestiones y novedades importantes para la comunidad de Guacanal.</p>

		{comunicados.length === 0 && (
			<p class="mt-12 text-ink/60 italic">Aún no hay comunicados publicados.</p>
		)}

		<div class="mt-12 space-y-10">
			{comunicados.map((entry, i) => {
				const { Content } = rendered[i];
				return (
					<article class="border-t border-ink/10 pt-8">
						<p class="text-xs font-semibold tracking-[0.1em] text-navy/80 uppercase">{formatDate(entry.data.date)}</p>
						<h2 class="mt-2 font-display font-semibold text-xl sm:text-2xl text-ink">{entry.data.title}</h2>
						{entry.data.autor && <p class="mt-1 text-sm text-ink/50">{entry.data.autor}</p>}
						<div class="prose prose-p:text-ink/80 prose-headings:font-display max-w-none mt-4">
							<Content />
						</div>
					</article>
				);
			})}
		</div>
	</section>
</BaseLayout>
