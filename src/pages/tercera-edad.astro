---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import OrgPage from '../components/OrgPage.astro';

const entry = await getEntry('organizaciones', 'tercera-edad');
if (!entry) throw new Error('Entrada "tercera-edad" no encontrada en la colección organizaciones');
---

<BaseLayout title={entry.data.title} description={entry.data.tagline}>
	<OrgPage entry={entry} />
</BaseLayout>
