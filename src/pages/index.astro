---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import OrgCard from '../components/OrgCard.astro';
import Gallery from '../components/Gallery.astro';
import MapEmbed from '../components/MapEmbed.astro';
import ContactForm from '../components/ContactForm.astro';
import HistoryTimeline from '../components/HistoryTimeline.astro';
import { url } from '../lib/base';

const organizaciones = (await getCollection('organizaciones', ({ data }) => data.visible)).sort((a, b) => a.data.order - b.data.order);

const historia = [
	{
		fecha: '1886–1891',
		titulo: 'Orígenes',
		texto:
			'El nombre "Guacanal" nace de los inmensos árboles de guácano que abundaban en la zona y con los que la comunidad identificaba el lugar. La colonización se dio hacia 1886, y su fundación como vereda quedó reconocida el 15 de mayo de 1891. Entre sus primeros habitantes se recuerda a María Josefa, Ramona, Ernesto Sánchez, Lucrecia Sánchez, Damián Paz Molina, Hipólito Saavedra y Bonifacio Molina, entre otros, quienes tomaron posesión de tierras baldías, trazaron callejones y abrieron las primeras vías. Muchas de esas familias fundadoras permanecen en la vereda hasta hoy, generación tras generación.',
	},
	{
		fecha: '1961',
		titulo: 'Vida y tradición campesina',
		texto:
			'Ante la falta de un lugar donde los niños de la vereda pudieran estudiar, un grupo de vecinos conformó el comité "Pro-Construcción de la Escuela de la Vereda". Gestionaron la donación de un lote —escritura pública No. 259 del 23 de febrero de 1961— y levantaron con trabajo comunitario la Escuela Simón Bolívar, hoy adscrita a la Institución Educativa Jorge Isaacs. En el campo, los cultivos también contaban su propia historia: donde antes se sembraba algodón, maíz, sorgo, soya, plátano y cítricos, hoy predomina la caña de azúcar.',
	},
	{
		fecha: '1972–1984',
		titulo: 'Hitos importantes',
		texto:
			'El 19 de mayo de 1972, mediante la Resolución 2040, la Gobernación reconoció la personería jurídica de la Junta de Acción Comunal de la Vereda de Guacanal, con Remigio Saavedra como primer presidente. Bajo ese liderazgo comunitario llegaron dos conquistas que transformaron la vereda: el servicio de energía eléctrica en 1982 y el acueducto veredal en 1984.',
	},
	{
		fecha: 'Hoy',
		titulo: 'Guacanal hoy',
		texto:
			'Hoy Guacanal limita con la cabecera municipal de El Cerrito, el municipio de Vijes, Ginebra y Palmira —o, como dicen sus habitantes, entre los ríos Amaime, Zabaletas y Cauca. A 966 metros sobre el nivel del mar, conviven cultivos de aguacate, tomate, plátano, cítricos y maracuyá con una fauna y flora abundante: samanes, guadua, heliconias, torcazas, garzas y armadillos. Y no puede faltar un sabor propio: el dulce manjar blanco que prepara todo el año la señora Aracely Satizabal, reconocido por su elaboración y buen sabor.',
	},
];
---

<BaseLayout title="Inicio" accent="green">
	<section id="inicio">
		<img
			src={url('/images/banners/principal.png')}
			alt="Guacanal, Juntos por nuestra vereda — Trabajamos unidos por el desarrollo, el bienestar y el futuro de nuestra gente"
			class="w-full h-auto sm:h-36 md:h-44 sm:object-cover sm:object-left"
		/>
		<div class="bg-white border-b border-ink/10 py-8">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-wrap items-center justify-between gap-4">
				<p class="text-sm text-ink/60">
					3.67917°N · 76.36917°O · 966 msnm — San Antonio, El Cerrito, Valle del Cauca
				</p>
				<a
					href="#historia"
					class="inline-flex items-center gap-2 rounded-md bg-green text-white px-6 py-2.5 font-semibold hover:bg-green/90 transition-colors"
				>
					Conoce nuestra historia
				</a>
			</div>
		</div>
	</section>

	<section id="historia" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
		<p class="text-xs font-semibold tracking-[0.15em] text-green uppercase">Reseña histórica</p>
		<h2 class="mt-3 font-display font-bold text-3xl sm:text-4xl text-ink">Historia de Guacanal</h2>

		<div class="mt-16">
			<HistoryTimeline historia={historia} accent="green" />
		</div>
	</section>

	<section id="galeria" class="bg-white border-y border-ink/10 py-20 sm:py-28">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<p class="text-xs font-semibold tracking-[0.15em] text-green uppercase">Cuaderno de campo</p>
			<h2 class="mt-3 font-display font-bold text-3xl sm:text-4xl text-ink">Galería de fotos</h2>
			<p class="mt-3 text-ink/70 max-w-xl">El paisaje, los cultivos y la vida comunitaria de Guacanal.</p>
			<div class="mt-12">
				<Gallery />
			</div>
		</div>
	</section>

	<section id="como-llegar" class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 sm:py-28">
		<p class="text-xs font-semibold tracking-[0.15em] text-green uppercase">Ubicación</p>
		<h2 class="mt-3 font-display font-bold text-3xl sm:text-4xl text-ink">Cómo llegar</h2>
		<p class="mt-3 text-ink/70">
			Guacanal está en el corregimiento de San Antonio, municipio de El Cerrito, Valle del Cauca.
		</p>
		<div class="mt-10">
			<MapEmbed />
		</div>
	</section>

	<section id="organizaciones" class="bg-white border-t border-ink/10 py-20 sm:py-28">
		<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
			<p class="text-xs font-semibold tracking-[0.15em] text-green uppercase">Registro comunal</p>
			<h2 class="mt-3 font-display font-bold text-3xl sm:text-4xl text-ink">Nuestras organizaciones</h2>
			<p class="mt-3 text-ink/70 max-w-xl">Las comunidades organizadas que dan vida a Guacanal.</p>
			<div class="mt-12 border-t border-ink/10">
				{organizaciones.map((org, i) => <OrgCard org={org} index={i + 1} />)}
			</div>
		</div>
	</section>

	<section id="contacto" class="py-20 sm:py-28">
		<div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
			<p class="text-xs font-semibold tracking-[0.15em] text-green uppercase">Escríbenos</p>
			<h2 class="mt-3 font-display font-bold text-3xl sm:text-4xl text-ink">Contacto</h2>
			<p class="mt-3 text-ink/70">¿Tienes alguna pregunta o quieres saber más de la vereda? Escríbenos.</p>
			<div class="mt-10">
				<ContactForm accent="green" />
			</div>
		</div>
	</section>
</BaseLayout>
