---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/base';
---

<BaseLayout title="Gracias" description="Gracias por escribirnos.">
	<section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">
		<p class="text-xs font-semibold tracking-[0.15em] text-green uppercase">Mensaje enviado</p>
		<h1 class="mt-4 font-display font-bold text-3xl text-ink">¡Gracias por escribirnos!</h1>
		<p class="mt-3 text-ink/70">Hemos recibido tu mensaje. Pronto alguien de la comunidad se pondrá en contacto contigo.</p>
		<a href={url('/')} class="mt-8 inline-flex items-center gap-2 rounded-md bg-green text-white px-6 py-2.5 font-semibold hover:bg-green/90 transition-colors">
			← Volver al inicio
		</a>
	</section>
</BaseLayout>
