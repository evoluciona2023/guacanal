---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Gracias" description="Gracias por escribirnos.">
	<section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">
		<p class="font-mono text-xs tracking-[0.2em] text-rio uppercase">Mensaje enviado</p>
		<h1 class="mt-4 font-serif italic text-4xl text-ink">¡Gracias por escribirnos!</h1>
		<p class="mt-3 text-ink/70">Hemos recibido tu mensaje. Pronto alguien de la comunidad se pondrá en contacto contigo.</p>
		<a href="/" class="mt-8 inline-flex items-center gap-2 rounded-sm bg-ink text-paper px-6 py-2.5 font-medium hover:bg-ember transition-colors">
			← Volver al inicio
		</a>
	</section>
</BaseLayout>
