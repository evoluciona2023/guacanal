---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Gracias" description="Gracias por escribirnos.">
	<section class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">
		<span class="text-5xl" aria-hidden="true">🌾</span>
		<h1 class="mt-4 font-serif text-3xl font-semibold text-bark">¡Gracias por escribirnos!</h1>
		<p class="mt-3 text-bark/70">Hemos recibido tu mensaje. Pronto alguien de la comunidad se pondrá en contacto contigo.</p>
		<a href="/" class="mt-8 inline-flex items-center gap-2 rounded-full bg-forest text-cream px-6 py-2.5 font-medium hover:bg-forest-light transition-colors">
			← Volver al inicio
		</a>
	</section>
</BaseLayout>
